;color:#0b0b0f;font-weight:800;\">{{ $json.body.nome_completo }}</h1>\n      <p style=\"margin:8px 0 0;font-size:17px;color:#6b6b78;\">{{ $json.body.cargo }} &middot; <span style=\"color:#0b0b0f;font-weight:700;\">{{ $json.body.empresa }}</span></p>\n    </td></tr>\n\n    <tr><td style=\"padding:26px 40px 0;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#fbfaf7\" style=\"background:#fbfaf7;border:1px solid #e6e5df;border-radius:14px;\">\n        <tr>\n          <td width=\"50%\" style=\"padding:16px 20px;border-bottom:1px solid #eceae3;\">\n            <div style=\"font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9a9aa6;padding-bottom:5px;\">E-mail</div>\n            <a href=\"mailto:{{ $json.body.email }}\" style=\"font-size:16px;color:#0e7a44;text-decoration:none;font-weight:500;\">{{ $json.body.email }}</a>\n          </td>\n          <td width=\"50%\" style=\"padding:16px 20px;border-bottom:1px solid #eceae3;border-left:1px solid #eceae3;\">\n            <div style=\"font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9a9aa6;padding-bottom:5px;\">WhatsApp</div>\n            <a href=\"https://wa.me/55{{ $json.body.whatsapp.replace(/\\D/g,'') }}\" style=\"font-size:16px;color:#0e7a44;text-decoration:none;font-weight:500;\">{{ $json.body.whatsapp }}</a>\n          </td>\n        </tr>\n        <tr>\n          <td width=\"50%\" style=\"padding:16px 20px;\">\n            <div style=\"font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9a9aa6;padding-bottom:5px;\">CPF</div>\n            <div style=\"font-size:16px;color:#0b0b0f;\">{{ $json.body.cpf_formatado }}</div>\n          </td>\n          <td width=\"50%\" style=\"padding:16px 20px;border-left:1px solid #eceae3;\">\n            <div style=\"font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9a9aa6;padding-bottom:5px;\">Recebido</div>\n            <div style=\"font-size:16px;color:#6b6b78;\">{{ new Date($json.body.criado_em).toLocaleString('pt-BR',{ timeZone:'America/Sao_Paulo' }) }}</div>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n\n    <tr><td style=\"padding:26px 40px 0;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td bgcolor=\"#68ee95\" style=\"background:#68ee95;border-radius:100px;\">\n          <a href=\"https://convite.mindsummit.company/admin\" style=\"display:inline-block;padding:15px 34px;font-size:16px;font-weight:700;color:#0b0b0f;text-decoration:none;\">Ver todas as confirmações &rarr;</a>\n        </td></tr>\n      </table>\n    </td></tr>\n\n    <tr><td style=\"padding:28px 40px 30px;\">\n      <div style=\"border-top:1px solid #e6e5df;padding-top:18px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td align=\"left\" style=\"font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9a9aa6;\">Mind Summit 2026</td>\n            <td align=\"right\" style=\"font-size:11px;color:#b0b0ba;\">16 e 17 de setembro &middot; São Paulo Expo</td>\n          </tr>\n        </table>\n      </div>\n    </td></tr>\n\n  </table>\n\n</td></tr></table>\n</body></html>",
