ttom:1px solid #f0efe9;font-size:13px;color:#8a8a9b;width:110px;\">E-mail</td>\n          <td style=\"padding:13px 16px;border-bottom:1px solid #f0efe9;font-size:15px;\"><a href=\"mailto:{{ $json.body.email }}\" style=\"color:#0b0b0f;text-decoration:none;\">{{ $json.body.email }}</a></td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 16px;border-bottom:1px solid #f0efe9;font-size:13px;color:#8a8a9b;\">WhatsApp</td>\n          <td style=\"padding:13px 16px;border-bottom:1px solid #f0efe9;font-size:15px;\"><a href=\"https://wa.me/55{{ $json.body.whatsapp.replace(/\\D/g,'') }}\" style=\"color:#0b0b0f;text-decoration:none;\">{{ $json.body.whatsapp }}</a></td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 16px;border-bottom:1px solid #f0efe9;font-size:13px;color:#8a8a9b;\">CPF</td>\n          <td style=\"padding:13px 16px;border-bottom:1px solid #f0efe9;font-size:15px;color:#0b0b0f;\">{{ $json.body.cpf_formatado }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 16px;font-size:13px;color:#8a8a9b;\">Recebido</td>\n          <td style=\"padding:13px 16px;font-size:15px;color:#55555f;\">{{ new Date($json.body.criado_em).toLocaleString('pt-BR',{ timeZone:'America/Sao_Paulo' }) }}</td>\n        </tr>\n      </table>\n    </td></tr>\n\n    <tr><td align=\"center\" style=\"padding:24px 30px 4px;\">\n      <a href=\"https://convite.mindsummit.company/admin\" style=\"display:inline-block;padding:14px 30px;border-radius:100px;background:#0b0b0f;color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;\">Ver todas as confirmações &rarr;</a>\n    </td></tr>\n\n    <tr><td align=\"center\" style=\"padding:12px 30px 28px;\">\n      <p style=\"margin:0;font-size:12px;color:#a0a0ad;line-height:1.5;\">\n        Painel: <a href=\"https://convite.mindsummit.company/admin\" style=\"color:#8a8a9b;\">convite.mindsummit.company/admin</a><br>\n        Mind Summit 2026 · 16 e 17 de setembro · São Paulo Expo\n      </p>\n    </t